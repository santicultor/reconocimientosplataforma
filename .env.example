# --- Navegador (públicas, van en Netlify como variables de entorno) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # llave "anon" / "publishable"

# --- Servidor (secretas, NUNCA con prefijo VITE_) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # llave "service_role" / "secret"
